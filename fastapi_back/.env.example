# MEDCLUES Backend — copy to .env and fill values (never commit .env)

# Core
DEBUG=true
PORT=5000
CURRENCY=INR
# Trust score: require Razorpay instead of pay-at-clinic for mid scores (default off when DEBUG=true)
# ADVANCE_PAYMENT_ENFORCED=false

# JWT (required when DEBUG=false: min 32 chars, random — NOT "greatstack")
# Generate: openssl rand -base64 48
JWT_SECRET=
# Optional separate refresh signing secret (defaults to JWT_SECRET)
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (required in production)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Connection pool (raise for concurrency; use PgBouncer in front for Neon)
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis (optional but required for multi-instance OTP / rate limits / Socket.IO / caches)
# REDIS_URL=redis://localhost:6379/0
# Local: docker compose up -d redis

# Optional read replica (search / heavy SELECTs); falls back to primary when unset
# DATABASE_READ_URL=

# OpenSearch (optional). When unset, /api/search uses Postgres ILIKE/FTS
# OPENSEARCH_URL=https://opensearch.example:9200
# OPENSEARCH_INDEX=medclues
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# Chaos probes at /api/ops/chaos/* (admin JWT). Keep false in production.
# CHAOS_ENABLED=false

# AI Medical Assistant (/api/ai/assistant/*) — default off
# AI_ASSISTANT_ENABLED=false
# For natural replies, enable LLM + set a provider key (backend only — never put keys in Flutter):
# AI_LLM_ENABLED=true
# AI_LLM_PROVIDER=cohere|mistral|openai|qwen
# AI_LLM_MODEL=command-r-plus|mistral-medium-latest|gpt-4.1-mini|qwen-plus
# COHERE_API_KEY=          # rotate if ever pasted in chat; Render secret only
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=   # Qwen (sk- / sk-ws-…); alias QWEN_API_KEY=
# AI_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Optional Cohere OpenAI-compatible URL (native Chat v2 used by default):
# AI_LLM_BASE_URL=https://api.cohere.com/compatibility/v1
# AI_ASSISTANT_RATE_LIMIT_RPM=30
# Module 1–3 NLU + workflow shadow log (plan only; does not change replies)
# AI_INTENT_ENGINE_SHADOW=false
# Module 8 — live chat uses new NLU pipeline for intent/entities (default off)
# After golden NL tests pass: AI_NLU_PIPELINE_CUTOVER=true (or keep false for shadow-first)
# AI_NLU_PIPELINE_CUTOVER=false
# Soft-validate Intent Dictionary YAML on API startup (default true; never blocks boot)
# AI_INTENT_DICTIONARY_VALIDATE_ON_START=true
# Soft-validate Entity Dictionary catalogs on API startup (default true; never blocks boot)
# AI_ENTITY_DICTIONARY_VALIDATE_ON_START=true
# AI_ENTITY_DICTIONARY_REDIS_CACHE=false
# Module 5 Synonym Engine (region overlay e.g. IN; soft-validate on start)
# AI_SYNONYM_REGION=IN
# AI_SYNONYM_VALIDATE_ON_START=true
# AI_SYNONYM_REDIS_CACHE=false
# Module 6 Abbreviation Engine
# AI_ABBREVIATION_VALIDATE_ON_START=true
# AI_ABBREVIATION_REDIS_CACHE=false
# Module 7 Spelling Correction Engine
# AI_SPELLING_VALIDATE_ON_START=true
# AI_SPELLING_REDIS_CACHE=false

# Run workers inside API (default true). For scale-out:
#   RUN_BACKGROUND_WORKERS_IN_API=false
#   python -m app.workers.runner
# RUN_BACKGROUND_WORKERS_IN_API=true

# SMS — twilio | msg91 | auto (tries both) | stub
# SMS_PROVIDER=auto
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=MEDCLU
# MSG91_TEMPLATE_ID=
# SMS_ENQUEUE_WHEN_UNCONFIGURED=false

# WhatsApp Cloud API (Meta)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Appointment cold archive (days / batch size)
# APPOINTMENT_ARCHIVE_DAYS=365
# APPOINTMENT_ARCHIVE_BATCH=500

# Upload limits
# MAX_UPLOAD_BYTES=10485760
# ALLOWED_UPLOAD_MIME_PREFIXES=image/,application/pdf

# Ambulance operator JWT (defaults to JWT_SECRET; never use medclues-secret-change-me in prod)
# OPERATOR_JWT_SECRET=

# CORS (production) — comma-separated exact origins
# Example: https://medclues-admin.vercel.app,https://medclues.onrender.com
CORS_ALLOWED_ORIGINS=
#
# ── Public URL variables (one table) ──────────────────────────────────────────
# FRONTEND_URL          Patient web (Vite) origin — emails / CORS
# ADMIN_PANEL_URL       Admin/reception SPA origin — CORS + deep links
# ADMIN_URL             Alias of ADMIN_PANEL_URL (either env name works)
# PUBLIC_WEB_BASE_URL   Flutter web origin for Visit Summary QR (/#/a/{BK}?sig=).
#                       Prefer this in deployed envs. Empty → API HTML bridge only.
# BACKEND_URL           Canonical FastAPI base (docs / callbacks)
# PHARMACY_SERVICE_URL  Optional Express pharmacy catalog (not used for patient search)
#
# Booking payments: Flutter → POST /api/payments/create-order with amount in **paise**.
# Legacy POST /api/user/payment-razorpay always returns 410 — use /api/payments/*.
#
ADMIN_PANEL_URL=https://medclues-admin.vercel.app
# ADMIN_URL=https://medclues-admin.vercel.app
# Optional extra CORS origin regex (advanced)
# CORS_ORIGIN_REGEX=
FRONTEND_URL=http://localhost:5173
# PUBLIC_WEB_BASE_URL is required in production for Visit Summary QR to open Flutter web.
# Example: https://app.medclues.com  → QR uses /#/a/{BK}?sig=…
# If empty, QR falls back to API HTML bridge /link/appointment-summary/… (ok for local only).
PUBLIC_WEB_BASE_URL=
BACKEND_URL=http://localhost:5000
# Optional Express pharmacy catalog sync only — leave unset to skip (no hard default).
# PHARMACY_SERVICE_URL=

# Google OAuth — for social login idToken verification
# Use Firebase Web client ID(s), comma-separated for multiple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
# Legacy email-only social login without idToken (config default: true until clients send idToken).
# In production (DEBUG=false), validate_settings warns if still true — set false when clients send idToken.
SOCIAL_LOGIN_ALLOW_LEGACY=

# Firebase phone (SMS OTP) verification at signup.
# Project id is the audience of the phone ID token sent by the app.
# Firebase project id (existing project; typo "mediclues" is historical — do not invent a new id without a rename sprint)
FIREBASE_PROJECT_ID=mediclues-e39db
# When true, signup is rejected unless a valid Firebase phone token is sent.
# Keep false until Firebase Phone auth is fully configured (SHA + Phone provider enabled).
PHONE_VERIFICATION_REQUIRED=false

# Firebase Cloud Messaging (push notifications) — Firebase Admin service account.
# Provide ONE of these:
#  - FIREBASE_CREDENTIALS_JSON: paste the full service-account JSON (easiest on Render)
#  - FIREBASE_CREDENTIALS_PATH: path to the service-account JSON file (e.g. Render Secret File /etc/secrets/firebase.json)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SENDER_ID=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — Key ID + Secret must be the same mode (both test or both live)
# from Dashboard → Settings → API Keys. Mismatched pairs cause "Authentication failed".
# Local DEBUG only: set RAZORPAY_MOCK=true to book without real Razorpay keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MOCK=false
# Webhook secret from Razorpay Dashboard → Webhooks (for POST /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# PayU (optional legacy) — all three required to enable; no test-URL or key fallbacks in code
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Example test host: https://test.payu.in/_payment  | live: https://secure.payu.in/_payment
PAYU_BASE_URL=
# Optional UPI collect display — leave empty to disable (no demo@upi fallback)
MERCHANT_UPI_ID=

# Email (Brevo or Gmail SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@medclues.com
BREVO_SENDER_NAME=MedClues
BREVO_APP_NAME=MedClues
# Public logo URL for transactional emails (Cloudinary CDN recommended)
# Cloudinary Media Library layout (auto-created on upload):
#   medclues/patients/{public_id}/profile|reports
#   medclues/doctors/{public_id}/profile
#   medclues/job-applications
EMAIL_LOGO_URL=https://res.cloudinary.com/dinbiaq7q/image/upload/v1781150365/medclues/branding/medclues_logo_email.png
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Support inbox for Contact Us / footer copy (testing Gmail until domain mailbox exists)
SUPPORT_EMAIL=support@medclues.com
SUPPORT_PHONE=1800-123-4567

# Agora video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# AI (optional)
GEMINI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=

# Telegram bot (@medcluesBot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=medcluesBot
# Deep link scheme for Telegram / payment return (canonical: medclues://)
# Legacy aliases: mediclues, medichain (accepted by apps; primary emit is MEDCLUES_APP_DEEP_LINK_SCHEME)
MEDCLUES_APP_DEEP_LINK_SCHEME=medclues
MEDCLUES_APP_DEEP_LINK_ALIASES=mediclues,medichain
# Must match flutter_mobile android applicationId until package-rename sprint
MEDCLUES_ANDROID_PACKAGE=com.medichain.medichain_mobile
# Only one process may poll getUpdates. Set false locally when Render (or another host) is polling.
TELEGRAM_BOT_ENABLED=false

# Appointment lifecycle + trust score (config defaults: both true)
# When true, status transitions and trust-score rules are enforced server-side.
APPOINTMENT_LIFECYCLE_ENFORCED=true
TRUST_SCORE_ENFORCED=true

# MedClues external bot (optional). MEDCLUES_BOT_* preferred; MEDICHAIN_BOT_* still accepted.
MEDCLUES_BOT_BASE_URL=
MEDCLUES_BOT_API_KEY=
MEDCLUES_BOT_PASSWORD=
MEDICHAIN_BOT_BASE_URL=
MEDICHAIN_BOT_API_KEY=
MEDICHAIN_BOT_PASSWORD=

# Missed consultation slot + auto expire/cancel (Render: set true; local DEBUG=true defaults off)
# Behavior: slot ended +30min IST → MISSED (tomorrow reschedule offer) → EOD auto-CANCELLED/CLOSED
# Explicit env overrides; if unset: on when DEBUG=false, off when DEBUG=true
AUTO_NO_SHOW_JOB=true
# Local testing without auto-miss: AUTO_NO_SHOW_JOB=false

# openFDA Drug Label API — get a key at https://api.data.gov/signup/
# Never commit the real key; never expose it to Flutter/admin clients.
OPENFDA_API_KEY=
# Optional tuning
# OPENFDA_CACHE_TTL_SECONDS=1800
# OPENFDA_TIMEOUT_SECONDS=10

# PharmaSync integration (Hospital Dean connect + Rx/order webhooks)
# Get these from the PharmaSync team. Never commit real values.
PHARMASYNC_BASE_URL=https://medclues-pharmacy-backend.onrender.com
PHARMASYNC_HOSPITAL_CODE=medclues_hospital_main
PHARMASYNC_PUBLIC_API_KEY=
PHARMASYNC_PRIVATE_SECRET_KEY=
PHARMASYNC_WEBHOOK_SIGNING_SECRET=
# Webhook receiver on PharmaSync (confirm exact path with PharmaSync team)
PHARMASYNC_WEBHOOK_URL=
# Optional: override provision endpoint path (default /api/integration/pharmacies)
# PHARMASYNC_PROVISION_PATH=/api/integration/pharmacies
# Legacy alias still supported:
# PHARMASYNC_INTEGRATION_API_KEY=
