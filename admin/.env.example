# Copy to admin/.env and restart `npm run dev`
#
# Point VITE_BACKEND_URL at the SAME FastAPI host the Flutter app uses for that
# test session (local :5000 OR Render) — avoid dual-DB confusion.
#
# Local FastAPI (doctor browser + phone on same Wi‑Fi):
VITE_BACKEND_URL=http://localhost:5000
# Production Render (use with production APK):
# VITE_BACKEND_URL=https://medclues.onrender.com
#
# Optional Express pharmacy catalog (Pharmacy Master Catalog only). Unset = disabled.
# VITE_PHARMACY_SERVICE_URL=http://localhost:5001

VITE_CURRENCY=INR
VITE_ENABLE_SOCKET=false
